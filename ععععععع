local function StartAttachLoop(mode)
    if TargetPlayerName == "" then
        Rayfield:Notify({Title = "خطأ", Content = "يرجى اختيار لاعب من القائمة أولاً!", Duration = 3})
        return
    end
    if AttachLoop then AttachLoop:Disconnect(); AttachLoop = nil end
    CurrentMode = mode
    TimeCounter = 0
    local wasWaiting = false
    
    AttachLoop = RunService.Heartbeat:Connect(function(deltaTime)
        if TargetPlayerName == "" then
            if AttachLoop then AttachLoop:Disconnect(); AttachLoop = nil end
            return
        end
        local targetPlayer = game.Players:FindFirstChild(TargetPlayerName)
        local lp = game.Players.LocalPlayer
        
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") 
           and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            if wasWaiting then
                wasWaiting = false
                Rayfield:Notify({Title = "🔥 Troll Resume", Content = "اللاعب " .. TargetPlayerName .. " عاد! تم استئناف الحركة.", Duration = 3})
            end
            local targetRoot = targetPlayer.Character.HumanoidRootPart
            local localRoot = lp.Character.HumanoidRootPart
            localRoot.Velocity = Vector3.new(0, 0, 0)
            if BangSpeed > 0 then
                TimeCounter = TimeCounter + (deltaTime * BangSpeed * 2)
            else
                TimeCounter = 0
            end
            if CurrentMode == "MOUTH" then
                local bangOffset = math.sin(TimeCounter) * 0.75
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 1.25, -0.4 + bangOffset) * CFrame.Angles(0, math.rad(180), 0)
            elseif CurrentMode == "BACK" then
                local bangOffset = math.sin(TimeCounter) * 0.75
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -0.5, 0.4 - bangOffset)
            elseif CurrentMode == "ROTATE" then
                local radius = 2
                local x = math.cos(TimeCounter) * radius
                local z = math.sin(TimeCounter) * radius
                localRoot.CFrame = CFrame.new(targetRoot.Position + Vector3.new(x, 1, z), targetRoot.Position)
            end
        else
            if not wasWaiting then
                wasWaiting = true
                Rayfield:Notify({Title = "⏳ Troll Waiting", Content = "اللاعب " .. TargetPlayerName .. " غادر مؤقتاً. بانتظار عودته...", Duration = 3})
            end
        end
    end)
end

OthersTab:CreateButton({ Name = "Mouth Bang (حركة أمامية)", Callback = function() StartAttachLoop("MOUTH") end })
