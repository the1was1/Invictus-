local function isBeingGrabbed(character)
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Constraint") or descendant:IsA("Weld") or descendant:IsA("WeldConstraint") then
            local name = descendant.Name:lower()
            if name:find("grab") or name:find("carry") or name:find("hold") or name:find("stun") then
                return true
            end
        end
    end
    return false
