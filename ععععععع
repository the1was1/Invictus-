local function isSafe(name)
  local lowerName = name:lower()
  local boxes = {
      SAVE.safe1, SAVE.safe2, SAVE.safe3, SAVE.safe4, SAVE.safe5,
      SAVE.safe6, SAVE.safe7, SAVE.safe8, SAVE.safe9, SAVE.safe10
  }
  for _, boxText in ipairs(boxes) do
      if boxText and boxText ~= "" and boxText ~= "None" then
          for s in boxText:gmatch("%S+") do
              if lowerName:find(s:lower(), 1, true) then return true end
          end
      end
  end
  return false
end

local function isSelectedEnemy(name)
  local lowerName = name:lower()
  local boxes = {
      SAVE.enemy1, SAVE.enemy2, SAVE.enemy3, SAVE.enemy4, SAVE.enemy5,
      SAVE.enemy6, SAVE.enemy7, SAVE.enemy8, SAVE.enemy9, SAVE.enemy10
  }
  for _, boxText in ipairs(boxes) do
      if boxText and boxText ~= "" and boxText ~= "None" then
          if lowerName == boxText:lower() or lowerName:find(boxText:lower(), 1, true) then 
              return true 
          end
      end
  end
  return false
end

