                targetColor = Color3.new(intensity, intensity, intensity)
            elseif currentBioMode == "Rainbow" then targetColor = Color3.fromHSV(bioHue, 1, 1)
            elseif currentBioMode == "Pulse" then targetColor = Color3.fromHSV(bioHue, 0.8, 1)
            elseif currentBioMode == "Strobe" then targetColor = Color3.fromRGB(math.random(50,255), math.random(50,255), math.random(50,255))
            elseif currentBioMode == "Police" then 
                bioPoliceToggle = not bioPoliceToggle
                targetColor = bioPoliceToggle and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(255, 0, 0) 
            end
            if targetColor then pcall(function() bioColorRemote:FireServer(targetColor) end) end
