local function forceUnbindAndReset(chr)
    if not chr then return end
    local hum = chr:FindFirstChildWhichIsA("Humanoid")
    local root = chr:FindFirstChild("HumanoidRootPart") or chr:FindFirstChild("Torso")

    for _, obj in ipairs(chr:GetDescendants()) do
        if obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("ManualWeld") or obj:IsA("AlignPosition") or obj:IsA("AlignOrientation") then
            local p0, p1 = nil, nil
            if obj:IsA("AlignPosition") or obj:IsA("AlignOrientation") then
                p0 = obj.Attachment0 and obj.Attachment0.Parent
                p1 = obj.Attachment1 and obj.Attachment1.Parent
            else
                p0 = obj.Part0
                p1 = obj.Part1
            end
            if p0 and p1 then
                if not p0:IsDescendantOf(chr) or not p1:IsDescendantOf(chr) then obj:Destroy() end
            end
        elseif obj.Name == "MobileFlyGyro" or obj.Name == "MobileFlyVelocity" then
            obj:Destroy()
        end
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
        for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            pcall(function() hum:SetStateEnabled(state, true) end)
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        task.wait()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait()
        hum:ChangeState(Enum.HumanoidStateType.Running)
        if chr:FindFirstChild("Animate") then chr.Animate.Disabled = false end
    end
end

local function toggleFly(Value)
    nowe = Value
    local chr = lp.Character
    local hum = chr and chr:FindFirstChildWhichIsA("Humanoid")
    local root = chr and (chr:FindFirstChild("HumanoidRootPart") or chr:FindFirstChild("Torso"))
    
    if not chr or not hum or not root then return end

    if not nowe then
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        forceUnbindAndReset(chr)
    else
        forceUnbindAndReset(chr) 
        hum.AutoRotate = false
        if chr:FindFirstChild("Animate") then chr.Animate.Disabled = true end
        for _, v in ipairs(hum:GetPlayingAnimationTracks()) do v:AdjustSpeed(0) end

        local bv = Instance.new("BodyVelocity")
        bv.Name = "MobileFlyVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = root
        
        local bg = Instance.new("BodyGyro")
        bg.Name = "MobileFlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 9000
        bg.Parent = root

        if flyConnection then flyConnection:Disconnect() end
        
        flyConnection = RunService.RenderStepped:Connect(function()
            local currentChr = lp.Character
            local currentHum = currentChr and currentChr:FindFirstChildWhichIsA("Humanoid")
            local currentRoot = currentChr and (currentChr:FindFirstChild("HumanoidRootPart") or currentChr:FindFirstChild("Torso"))
            
            if currentChr and currentHum and currentRoot and nowe then
                currentHum:ChangeState(Enum.HumanoidStateType.Swimming)
                local camCF = camera.CFrame
                bg.CFrame = camCF
                local moveDir = currentHum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local localMove = camCF:VectorToObjectSpace(moveDir)
                    local flightDir = camCF:VectorToWorldSpace(localMove)
                    bv.Velocity = flightDir * flySpeed
                else
                    bv.Velocity = Vector3.zero
                end
            else
                if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
            end
        end)
    end
end

