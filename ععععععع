local walkFlingConnection = nil
local antiWalkFlingToggleState = false
local walkFlingPower = 50000 
local isHugging = false
local isGrabPause = false

local function notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {Title = title, Text = text, Duration = 3})
    end)
end

local function stopWalkFling()
    if walkFlingConnection then walkFlingConnection:Disconnect(); walkFlingConnection = nil end
    if lp.Character then
        for _, part in ipairs(lp.Character:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end
end

local function startWalkFling()
    stopWalkFling()
    if not antiWalkFlingToggleState or isHugging or isGrabPause then return end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not hum or hum.Health <= 0 or not root then return end

    local movel = 0.1
    walkFlingConnection = RunService.Heartbeat:Connect(function()
    if isHugging or isGrabPause or not antiWalkFlingToggleState then return end
    if getgenv().IsFlinging then return end
    if tick() < _G.teleportPauseUntil then return end
    local currentChar = lp.Character
    local currentRoot = currentChar and (currentChar:FindFirstChild("HumanoidRootPart") or currentChar:FindFirstChild("Torso"))
        local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
        if not currentRoot or not currentHum then return end
        if currentHum.MoveDirection.Magnitude > 0 then return end

        pcall(function()
            local oldVel = currentRoot.AssemblyLinearVelocity
            local currentPos = currentRoot.CFrame
            currentRoot.AssemblyLinearVelocity = Vector3.new(walkFlingPower, walkFlingPower, walkFlingPower)
            RunService.RenderStepped:Wait()
            currentRoot.CFrame = currentPos 
            if isHugging or isGrabPause or not antiWalkFlingToggleState or currentHum.MoveDirection.Magnitude > 0 then
                currentRoot.AssemblyLinearVelocity = Vector3.zero
                return
            end
            currentRoot.AssemblyLinearVelocity = oldVel
            RunService.Stepped:Wait()
            currentRoot.CFrame = currentPos 
            if isHugging or isGrabPause or not antiWalkFlingToggleState or currentHum.MoveDirection.Magnitude > 0 then
                currentRoot.AssemblyLinearVelocity = Vector3.zero
                return
            end
            currentRoot.AssemblyLinearVelocity = oldVel + Vector3.new(0, movel, 0)
            currentRoot.CFrame = currentPos
            movel = movel * -1
        end)
    end)
end

pcall(function()
    if not hookmetamethod then return end
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod and getnamecallmethod() or ""
        if not checkcaller() and method == "InvokeServer" then
            if self.Name == "StartJointEmote" then
                local anim = args[1]
                if typeof(anim) == "Instance" and (anim.Name:find("Hold") or anim.Name:find("Hug") or (anim.Parent and anim.Parent.Name == "Hugs")) then
                    if not isHugging then
                        isHugging = true
                        task.spawn(function()
                            stopWalkFling()
                            notify("حماية الفلينق", "تم إيقاف الفلينق 🫂 (احتضان آمن)")
                        end)
                    end
                end
            elseif self.Name == "CancelJointEmote" then
                if isHugging then
                    task.spawn(function()
                        notify("حماية الفلينق", "تم الإفلات.. ننتظر ابتعاد الشخصية ⏳")
                        task.wait(2) 
                        isHugging = false
                        if antiWalkFlingToggleState and not isGrabPause then
                            startWalkFling()
                            notify("حماية الفلينق", "تم إعادة تشغيل الفلينق ⚠️")
                        end
                    end)
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
end)

local function setupCharacter(char)
    stopWalkFling()
    isHugging = false
    isGrabPause = false

    local hum = char:WaitForChild("Humanoid", 5)
    if hum then 
        hum.Died:Connect(function() stopWalkFling() end) 
        local function handleGrabPause()
            if isGrabPause or not antiWalkFlingToggleState then return end
            isGrabPause = true
            stopWalkFling()
            notify("حماية الفلينق", "تم إيقاف الفلينق لـ 6 ثوانٍ لأنك تقوم بإمساك لاعب 🛑")
            task.spawn(function()
                task.wait(6)
                isGrabPause = false
                if antiWalkFlingToggleState and not isHugging then
                    startWalkFling()
                    notify("حماية الفلينق", "عاد الفلينق للعمل ⚠️")
                end
            end)
        end

        char.DescendantAdded:Connect(function(child)
            task.wait(0.05)
            if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
                local p0, p1 = child.Part0, child.Part1
                if p0 and p1 then
                    local char0 = p0:FindFirstAncestorOfClass("Model")
                    local char1 = p1:FindFirstAncestorOfClass("Model")
                    if (char0 == char and char1 ~= char and char1:FindFirstChildOfClass("Humanoid")) or
                       (char1 == char and char0 ~= char and char0:FindFirstChildOfClass("Humanoid")) then
                        local state = hum:GetState()
                        if state ~= Enum.HumanoidStateType.PlatformStanding and state ~= Enum.HumanoidStateType.Physics then
                            handleGrabPause()
                        end
                    end
                end
            end
        end)
    end
    
    if antiWalkFlingToggleState then
        task.wait(1)
        startWalkFling()
    end
end

